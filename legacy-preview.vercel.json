{
  "version": 2,
  "framework": null,
  "buildCommand": "node scripts/build-legacy-gallery.mjs",
  "installCommand": "",
  "outputDirectory": "legacy-preview",
  "headers": [
    {"source": "/(.*)", "headers": [
      {"key": "X-Robots-Tag", "value": "noindex, nofollow"},
      {"key": "X-Content-Type-Options", "value": "nosniff"},
      {"key": "Referrer-Policy", "value": "no-referrer"}
    ]},
    {"source": "/legacy/snapshots/(.*)", "headers": [
      {"key": "Content-Security-Policy", "value": "sandbox allow-scripts; default-src 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; script-src 'self'; connect-src 'none'; form-action 'none'"}
    ]}
  ]
}
